# OAuth 2.0 client ("Web application") from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an "Authorized redirect URI" of the OAuth client
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Where to send the browser after connecting (Angular dev server, or the server itself when serving the built PWA)
WEB_ORIGIN=http://localhost:4200

PORT=3000
BACKFILL_DAYS=30
DB_PATH=../data/health.db
